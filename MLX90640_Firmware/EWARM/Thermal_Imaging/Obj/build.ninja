#Generating source browse information for project Thermal_Imaging


#Abbreviations
cc = C$:\Users\chengliang\Desktop\IAR84\common\bin\SourceIndexer.exe
ll = C$:\Users\chengliang\Desktop\IAR84\common\bin\PbdLink.exe
bd = C$:\Users\chengliang\Desktop\IAR84\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build adc.pbi : index adc.xcl
build fsmc.pbi : index fsmc.xcl
build gpio.pbi : index gpio.xcl
build i2c.pbi : index i2c.xcl
build main.pbi : index main.xcl
build spi.pbi : index spi.xcl
build stm32f4xx_hal_msp.pbi : index stm32f4xx_hal_msp.xcl
