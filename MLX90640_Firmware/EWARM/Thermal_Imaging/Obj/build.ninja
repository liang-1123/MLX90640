build Thermal_Imaging_part2.pbi : link MLX90640_API.pbi MLX90640_I2C_Driver.pbi lcd.pbi w25q64.pbi system_stm32f4xx.pbi stm32f4xx_hal.pbi stm32f4xx_hal_adc.pbi stm32f4xx_hal_adc_ex.pbi
build Thermal_Imaging_part3.pbi : link stm32f4xx_hal_cortex.pbi stm32f4xx_hal_dma.pbi stm32f4xx_hal_dma_ex.pbi stm32f4xx_hal_exti.pbi stm32f4xx_hal_flash.pbi stm32f4xx_hal_flash_ex.pbi stm32f4xx_hal_flash_ramfunc.pbi stm32f4xx_hal_gpio.pbi
build Thermal_Imaging_part4.pbi : link stm32f4xx_hal_i2c.pbi stm32f4xx_hal_i2c_ex.pbi stm32f4xx_hal_pcd.pbi stm32f4xx_hal_pcd_ex.pbi stm32f4xx_hal_pwr.pbi stm32f4xx_hal_pwr_ex.pbi stm32f4xx_hal_rcc.pbi stm32f4xx_hal_rcc_ex.pbi
build Thermal_Imaging_part5.pbi : link stm32f4xx_hal_spi.pbi stm32f4xx_hal_sram.pbi stm32f4xx_hal_tim.pbi stm32f4xx_hal_tim_ex.pbi stm32f4xx_hal_uart.pbi stm32f4xx_ll_adc.pbi stm32f4xx_ll_fsmc.pbi stm32f4xx_ll_usb.pbi
build Thermal_Imaging_part6.pbi : link diskio.pbi ff.pbi ff_gen_drv.pbi syscall.pbi usbd_core.pbi usbd_ctlreq.pbi usbd_ioreq.pbi usbd_msc.pbi
build Thermal_Imaging_part7.pbi : link usbd_msc_bot.pbi usbd_msc_data.pbi usbd_msc_scsi.pbi
build Thermal_Imaging.pbd : link Thermal_Imaging_part0.pbi Thermal_Imaging_part1.pbi Thermal_Imaging_part2.pbi Thermal_Imaging_part3.pbi Thermal_Imaging_part4.pbi Thermal_Imaging_part5.pbi Thermal_Imaging_part6.pbi Thermal_Imaging_part7.pbi
build Thermal_Imaging.pbw : browsedata Thermal_Imaging.pbd


